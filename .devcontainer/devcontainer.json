{
	"name": "byos_django devcontainer",
	"dockerComposeFile": [
		"../docker-compose.yml",
		"docker-compose.yml"
	],
	"service": "app",
	"workspaceFolder": "/src",
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-azuretools.vscode-docker",
				"knowsuchagency.pdm-task-provider"
			]
		}
	},
	"forwardPorts": [
		8000
	],
	"runServices": [
		"pw"
	],
	"postStartCommand": "python manage.py runserver 0.0.0.0:8000"
}